# ─────────────────────────────────────────────
# SITE IDENTITY
# Drives metadata, JSON-LD, sitemap, og: tags
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME="Studio Name"
NEXT_PUBLIC_SITE_DESCRIPTION="One sentence describing the studio and what they offer."

# ─────────────────────────────────────────────
# GOHIGHLEVEL (CRM)
# Contact-form submissions upsert directly into GHL — the photographer
# reads inquiries in the GHL inbox / mobile app. Server-only credentials.
# Get from: GHL → Settings → Private Integrations → New
# ─────────────────────────────────────────────
# Private Integration Token (Bearer auth)
GHL_PIT_TOKEN=
GHL_LOCATION_ID=                         # GHL Location ID (Settings → Business Profile)
#
# Ad-click IDs are written to GHL contact CUSTOM FIELDS so they resolve in a
# workflow's Meta Conversion API / Google Ads conversion step. Default set (8):
#   fbclid → {{contact.fbclid}}     fbc → {{contact.fbc}}    fbp → {{contact.fbp}}
#   gbraid → {{contact.gbraid}}     wbraid → {{contact.wbraid}}
#   ttclid → {{contact.ttclid}}     msclkid → {{contact.msclkid}}
#   li_fat_id → {{contact.li_fat_id}}
# gclid is NOT a custom field — contact.gclid is a read-only GHL STANDARD field.
# gclid rides the native attribution object we already send: use
#   {{contact.attributionSource.gclid}}   in the Google Ads conversion step.
# Custom fields are written BY ID (GHL silently drops by-key writes), resolved at
# runtime from GET /locations/{id}/customFields — so GHL_PIT_TOKEN needs the
# `locations/customFields.readonly` scope, or NO custom field will populate.
# Create the fields with the helper (idempotent; also needs customFields.write):
#   node scripts/ghl-attribution-fields.mjs --apply
# Options for this var:
#   unset             → send all 8 above
#   fbclid,fbc,fbp    → send only this subset
#   none              → disable entirely on this location
# A field a sub-account hasn't created is skipped at resolve time — the lead
# still saves and the fields that DO exist still populate, so leaving this at the
# default is safe even before you run the field-creator.
GHL_ATTRIBUTION_CUSTOM_FIELDS=

# ─────────────────────────────────────────────
# QUIZ FUNNEL (optional)
# Self-hosted interactive quiz funnel (popup + /quiz route + POST /api/v1/quiz).
# DISABLED by default. Set NEXT_PUBLIC_QUIZ_ENABLED=true to turn it on globally
# (a per-variation `enabled` flag in siteConfig.quiz/quizzes overrides this).
# Enabling it also advertises POST /api/v1/quiz to agents (openapi/llms/MCP/WebMCP).
#
# Lead delivery is server-side. GHL is the default target and REUSES the
# GHL_PIT_TOKEN + GHL_LOCATION_ID set above (the contact form's CRM) — no extra
# GHL creds needed. Optionally fan out to a generic webhook (Zapier/Make/etc.).
# ─────────────────────────────────────────────
NEXT_PUBLIC_QUIZ_ENABLED=                 # "true" to enable the quiz globally (default: off)
QUIZ_WEBHOOK_URL=                         # optional generic webhook (Zapier/Make/Mailchimp)
QUIZ_WEBHOOK_SECRET=                      # optional HMAC secret for X-Quiz-Signature (use ≥32 chars)

# ─────────────────────────────────────────────
# ANALYTICS (optional — production-only)
# Layout auto-renders <GoogleTagManager /> or <GoogleAnalytics /> from
# @next/third-parties when these are set AND VERCEL_ENV === "production".
# Localhost dev + preview deploys NEVER load analytics — no test traffic
# pollution. Missing ID = no script tag (never blocks build/launch).
# Override via siteConfig.analytics if you want IDs committed to the repo
# (most clients don't — env is safer).
#
# Preferred: load GA4 INSIDE GTM, set NEXT_PUBLIC_GTM_ID only.
# GA-only setup: leave GTM blank, set NEXT_PUBLIC_GA_ID.
# Both set: GTM wins, GA tag suppressed (avoid double-counting).
# ─────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=                      # GTM-XXXXXXX (Vercel production only)
NEXT_PUBLIC_GA_ID=                       # G-XXXXXXXXXX (only if not using GTM)

# ─────────────────────────────────────────────
# SECURITY CONTACT (optional)
# Overrides siteConfig.brand.email for /.well-known/security.txt
# Use a dedicated inbox for vulnerability reports.
# ─────────────────────────────────────────────
SECURITY_CONTACT_EMAIL=                  # security@yourdomain.com

# ─────────────────────────────────────────────
# SUBMISSIONS INGEST (agency admin)
# Every validated form, quiz, and MCP lead is also POSTed to the Agency OS
# portal — durable backup, client dashboard, and email alert. Unset = no-op.
# URL + token are issued per-client by the agency.
# ─────────────────────────────────────────────
SUBMISSIONS_INGEST_URL=
SUBMISSIONS_INGEST_TOKEN=
